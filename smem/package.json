{
  "name": "smart-memory",
  "version": "0.1.0",
  "description": "Smart Memory CLI core MVP",
  "license": "MIT",
  "type": "commonjs",
  "main": "./dist/cli/index.js",
  "bin": {
    "smem": "./dist/cli/index.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lightla/ai-research.git",
    "directory": "smem"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "package.json"
  ],
  "scripts": {
    "build": "node scripts/clean-dist.mjs && tsc -p tsconfig.build.json && node scripts/copy-assets.mjs",
    "clean": "node scripts/clean-dist.mjs",
    "dev": "tsx src/cli/index.ts",
    "install:global": "npm run build && npm install -g .",
    "uninstall:global": "npm uninstall -g smart-memory",
    "install:script": "sh ./install.sh",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "smem": "tsx src/cli/index.ts"
  },
  "dependencies": {
    "commander": "^14.0.2",
    "zod": "^4.2.1"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.15"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
